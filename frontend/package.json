{
  "name": "xivthecalamity",
  "version": "1.9.1",
  "description": "Final Fantasy XIV Cross-Platform Launcher",
  "main": "src/main/index.js",
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "build:renderer": "node scripts/build-renderer.js",
    "build": "npm run build:renderer && npm run build:cli && npm run build:backend && electron-builder",
    "build:cli": "node -e \"if(process.platform==='darwin'){require('child_process').execSync('cd ../XTCAudioRouter && ./build.sh release',{stdio:'inherit'})}else{console.log('Skipping XTCAudioRouter (macOS only)')}\"",
    "build:backend": "cd ../backend && dotnet publish src/XIVTheCalamity.Api.NativeAOT/XIVTheCalamity.Api.NativeAOT.csproj -c Release -r osx-arm64 -o ../Release/temp-backend",
    "build:dev": "npm run build:renderer && npm run build:cli && npm run build:backend && electron-builder --dir",
    "build:prod": "npm run build:renderer && npm run build:cli && npm run build:backend && electron-builder --dir",
    "pack": "npm run build:renderer && npm run build:cli && npm run build:backend && electron-builder --dir",
    "dist": "npm run build:renderer && npm run build:cli && npm run build:backend && electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.XIVTheCalamity.launcher",
    "productName": "XIVTheCalamity",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "electronLanguages": [
      "en-US",
      "zh-TW"
    ],
    "publish": {
      "provider": "github",
      "owner": "PlusoneChiang",
      "repo": "XIVTheCalamity"
    },
    "directories": {
      "output": "../Release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "dist/**/*",
      "resources/**/*",
      "package.json"
    ],
    "afterPack": "./electron-builder-afterpack.js",
    "afterSign": "./electron-builder-aftersign.js",
    "mac": {
      "category": "public.app-category.games",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/XIVTC.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "strictVerify": false,
      "notarize": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "../Release/temp-backend",
          "to": "backend",
          "filter": [
            "**/*",
            "!**/*.dSYM",
            "!**/*.dSYM/**"
          ]
        },
        {
          "from": "../shared/resources",
          "to": "resources",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icons",
      "extraResources": [
        {
          "from": "../Release/temp-backend-linux",
          "to": "backend",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "../shared/resources",
          "to": "resources",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "extraResources": []
  },
  "keywords": [
    "ff14",
    "ffxiv",
    "launcher",
    "electron"
  ],
  "author": "",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@otplib/preset-browser": "^12.0.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.7.3"
  }
}
